# --- Database (Postgres + pgvector) ---
# The app MUST connect as a NON-superuser for RLS to work (see sql/roles.sql).
# Replace the password with a real secret; keep it in sync with sql/roles.sql.
DATABASE_URL=postgres://docuask_app:change_me_app_pw@127.0.0.1:5433/docuask

# --- Public site URL ---
# Absolute origin used for canonical URLs, OpenGraph tags, sitemap.xml and
# robots.txt. Set this in production (e.g. https://docuask.id). On Vercel it
# falls back to the deployment URL; locally to http://localhost:3005.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# --- Embeddings ---
# cloudflare = @cf/baai/bge-m3 (1024-dim, semantic). hash = offline fallback.
EMBED_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Set to 1 to fail instead of silently falling back to hash embeddings.
# EMBED_STRICT=1

# --- LLM (any OpenAI-compatible endpoint) ---
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=your-model-name
LLM_API_KEY=

# --- Auth ---
# Comma-separated API keys that are auto-provisioned as tenants on first use.
# Replace with your own random keys; do NOT ship the example values.
DOCUASK_DEV_TENANT_KEYS=dev-key-one,dev-key-two

# --- Admin ---
# Shared secret for /admin and /api/admin (x-admin-token header).
# Unset = admin disabled (fail closed).
ADMIN_TOKEN=

# --- Customer sessions ---
# HMAC key for the login session cookie (signup/login/account). Rotating it
# logs every customer out. Falls back to ADMIN_TOKEN if unset; if BOTH are
# unset, signup/login are disabled (fail closed). Use a long random value.
SESSION_SECRET=

# --- Payment webhook ---
# Shared secret for POST /api/webhook/payment. The gateway signs the raw body
# with HMAC-SHA256 and sends it as `x-payment-signature`. Unset = webhook
# disabled (fail closed). In production the mock self-upgrade in /api/usage is
# disabled unless ALLOW_MOCK_UPGRADE=1.
PAYMENT_WEBHOOK_SECRET=
# Set to 1 to expose LLM/embed diagnostics from GET /api/chat to unauthenticated
# callers. Leave unset to keep internal endpoint/model names private.
# EXPOSE_PUBLIC_DIAGNOSTICS=1
